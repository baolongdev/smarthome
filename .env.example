# Server-only MongoDB Atlas connection string.
# Never use a NEXT_PUBLIC_ prefix for this variable.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority"
MONGODB_DB="smarthome"
TASMOTA_DEVICE_URL="http://192.168.1.100"
TASMOTA_DEVICE_URL_2="http://192.168.1.101"
